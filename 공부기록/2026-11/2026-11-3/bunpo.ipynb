    "q1,q3=df['x'].quantile([.25,.75])\n",
    "iqr=q3-q1\n",
    "print(df['x'].std(),q1,q3,iqr)\n",
    "plt.boxplot(df['x'].dropna(),vert=False); plt.show()"
   ]
