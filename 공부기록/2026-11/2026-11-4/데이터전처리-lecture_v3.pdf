   "source": [
    "fig, axes = plt.subplots(1, 3, figsize=(12, 3))\n",
    "for ax, col in zip(axes, ['feature', 'scaled_standard', 'scaled_minmax']):\n",
    "    ax.plot(basic.index, basic[col], 'o-')\n",
