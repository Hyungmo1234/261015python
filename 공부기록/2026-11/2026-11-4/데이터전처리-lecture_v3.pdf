       "      <td>1</td>\n",
       "    </tr>\n",
       "    <tr>\n",
       "      <th>4</th>\n",
       "      <td>오류</td>\n",
       "      <td>B</td>\n",
       "      <td>15.000000</td>\n",
       "      <td>0</td>\n",
       "    </tr>\n",
       "  </tbody>\n",
       "</table>"
      ],
      "text/plain": [
       "  price category    feature  target\n",
       "0   100        A  10.000000       0\n",
       "1   120        B  12.000000       0\n",
       "2   NaN        A  13.000000       0\n",
       "3   140      NaN  16.083333       1\n",
       "4    오류        B  15.000000       0"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "print(df.isna().sum())\n",
    "df_dropped = df.dropna()\n",
    "print('삭제 전후 행 수:', len(df), len(df_dropped))\n",
    "# 별도 복사본에서 평균 대체를 연습합니다.\n",
    "df_missing = df.copy()\n",
    "feature_mean = df_missing['feature'].mean()\n",
    "df_missing['feature'] = df_missing['feature'].fillna(feature_mean)\n",
    "assert df_missing['feature'].isna().sum() == 0\n",
    "display(df_missing.head())"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f644cb28",
   "metadata": {},
   "source": [
    "## 3. 중복 데이터 제거\n",
    "\n",
    "완전히 같은 행을 탐지합니다. 실제로 반복 관측한 값인지 수집 오류인지 확인한 후 제거해야 합니다. 독립된 반복 관측은 보존할 수 있습니다."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "2cf88f78",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "중복 행 수: 1\n",
      "중복 제거 전후: 13 12\n"
     ]
    }
   ],
   "source": [
    "print('중복 행 수:', df.duplicated().sum())\n",
    "df_clean = df.drop_duplicates().copy()\n",
    "print('중복 제거 전후:', len(df), len(df_clean))\n",
    "assert not df_clean.duplicated().any()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "0e033c9e",
   "metadata": {},
   "source": [
    "## 4. 데이터 타입 변환\n",
    "\n",
    "astype(float)는 잘못된 문자열이 있으면 오류가 납니다. to_numeric(errors=\"coerce\")는 잘못된 값을 NaN으로 바꾸므로 변환 뒤 결측치를 다시 확인합니다."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "9ea18269",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "price        float64\n",
      "category    category\n",
      "feature      float64\n",
      "target         int64\n",
      "dtype: object\n",
      "변환 뒤 결측치: 2\n"
     ]
    }
   ],
   "source": [
    "df_clean['price'] = pd.to_numeric(df_clean['price'], errors='coerce')\n",
    "df_clean['category'] = df_clean['category'].astype('category')\n",
    "print(df_clean.dtypes)\n",
    "print('변환 뒤 결측치:', df_clean['price'].isna().sum())\n",
    "# 여기부터는 기초 연습용 복사본입니다.\n",
    "basic = df_clean.copy()\n",
    "for col in ['price', 'feature']:\n",
    "    basic[col] = basic[col].fillna(basic[col].median())\n",
    "basic['category'] = basic['category'].cat.add_categories(['Unknown'])\n",
    "basic['category'] = basic['category'].fillna('Unknown')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "124aa5a1",
   "metadata": {},
   "source": [
    "## 5. 범주형 데이터 인코딩\n",
    "\n",
    "원-핫 인코딩은 범주마다 0/1 컬럼을 생성합니다. 명목 범주에 임의의 숫자 순서를 주는 일을 피할 수 있습니다. 학습·평가 데이터의 컬럼 구성이 같아야 합니다."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "912f7f9a",
   "metadata": {},
   "outputs": [
    {
